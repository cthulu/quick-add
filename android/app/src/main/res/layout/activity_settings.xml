<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Backend URL section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backend"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="URL of your Keep Quick Add server.\nEmulator: http://10.0.2.2:8000 · Device: http://&lt;your-ip&gt;:8000"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etBackendUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_background"
            android:hint="http://10.0.2.2:8000"
            android:inputType="textUri"
            android:padding="12dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary" />

        <Button
            android:id="@+id/btnTestConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test Connection"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/on_surface" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_variant"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <!-- Lists section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep Lists"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Names of Google Keep lists to add items to. The first entry is required and cannot be removed."
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Dynamic list inputs added here programmatically -->
        <LinearLayout
            android:id="@+id/listInputsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+ Add List"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/on_surface" />

        <!-- Save button -->
        <Button
            android:id="@+id/btnSaveUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Save"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
