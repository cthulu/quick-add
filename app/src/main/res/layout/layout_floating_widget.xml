<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <!-- Task name input -->
    <EditText
        android:id="@+id/etItemText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:background="@null"
        android:hint="Item"
        android:textColorHint="@color/hint_dark"
        android:textColor="@color/text_primary_dark"
        android:textSize="20sp"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:maxLines="1" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_dark" />

    <!-- Bottom bar: list selector + send button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- List dropdown (Inbox style) -->
        <Spinner
            android:id="@+id/spinnerLists"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/spinner_background_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:spinnerMode="dropdown" />

        <!-- Send / Add button -->
        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/btn_send_background"
            android:src="@drawable/ic_send"
            android:contentDescription="Add item"
            android:padding="8dp" />

    </RelativeLayout>

</LinearLayout>
