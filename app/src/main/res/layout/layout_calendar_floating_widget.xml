<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <!-- Surrounding-events preview panel (shown above the input when a date/time is parsed) -->
    <include
        android:id="@+id/previewPanel"
        layout="@layout/layout_event_preview_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Input row: text input for event title and datetime + buttons -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <!-- Event input field with hint examples -->
        <EditText
            android:id="@+id/etEventInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="e.g., Team sync tomorrow at 3pm"
            android:textColorHint="@color/widget_hint"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:maxLines="2" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="8dp"
            app:tint="?attr/colorPrimary"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_send_background"
            android:backgroundTint="?attr/colorPrimary"
            android:src="@drawable/ic_send"
            android:contentDescription="Save event"
            android:padding="8dp"
            app:tint="?attr/colorOnPrimary" />

    </LinearLayout>

</LinearLayout>
