<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_calendars"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCalendarStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_loading_calendars"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/calendarInputsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <CheckBox
            android:id="@+id/cbOpenCalendarEventDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_open_events_for_review" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/settings_open_events_for_review_summary"
            android:textColor="@color/on_surface_secondary"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbHideCalendarSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_hide_quick_add_settings" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/settings_hide_quick_add_settings_summary"
            android:textColor="@color/on_surface_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_variant"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_keep"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_pubnub_listener"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_pubnub_description"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_publish_key"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etPublishKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_background"
            android:hint="@string/settings_publish_key_hint"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_subscribe_key"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etSubscribeKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_background"
            android:hint="@string/settings_subscribe_key_hint"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_api_auth_key_optional"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_background"
            android:hint="@string/settings_api_auth_key_hint"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_channel"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_background"
            android:hint="@string/settings_channel_hint"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary" />

        <Button
            android:id="@+id/btnTestConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_test_connection"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_keep_lists"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_keep_lists_description"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/listInputsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_add_list"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/on_surface" />

        <Button
            android:id="@+id/btnSaveUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_save"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
