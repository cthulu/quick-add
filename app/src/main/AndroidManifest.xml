<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access for backend API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Calendar permissions for calendar quick-add -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_shortcut_add"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_shortcut_add"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeepQuickAdd"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KeepQuickAdd">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Static shortcut for Android 7.1+ (long-press app icon) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName=".MainActivity" />

        <!-- Trampoline shortcut activity that launches QuickAddActivity -->
        <activity
            android:name=".QuickAddShortcutActivity"
            android:exported="true"
            android:theme="@style/Theme.Transparent"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:label="@string/shortcut_label" />

        <!-- Bottom-sheet style activity hosting the quick-add popup -->
        <activity
            android:name=".QuickAddActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickAddDialog"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <!-- Bottom-sheet style activity hosting the calendar quick-add popup -->
        <activity
            android:name=".calendar.CalendarQuickAddActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickAddDialog"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

    </application>

</manifest>
